{
  "schemaVersion": 1,
  "id": "livingworld",
  "version": "${version}",
  "name": "The Living World",
  "description": "A terrain generation overhaul for Minecraft 1.20.1 that produces realistic continents, mountains, river valleys, plateaus, and climate-driven biome placement.",
  "authors": [
    "The Living World Team"
  ],
  "contact": {
    "sources": "https://github.com/MinLOL12/The-Living-World"
  },
  "license": "MIT",
  "icon": "assets/livingworld/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.livingworld.LivingWorld"
    ],
    "fabric-datagen": []
  },
  "mixins": [
    "livingworld.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
